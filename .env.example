# Copy to .env. Never commit .env. For an existing installation, preserve
# its existing PostgreSQL credentials instead of inventing a new password.
COMPOSE_PROJECT_NAME=queueops
POSTGRES_USER=queueops
POSTGRES_DB=queueops
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_GRAFANA_PASSWORD
# Optional: AI requests send supplied incident details to OpenAI and incur cost.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
